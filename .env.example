# Local operator-script config. Copy to .env (gitignored). Read by:
# retell/provision.mjs, scripts/doctor.mjs, scripts/dev-up.mjs,
# scripts/google-oauth-consent.mjs. The deployed Render API does NOT read this
# file — its environment lives in api/render.yaml + the Render dashboard.

# --- Retell provisioning ---
API_BASE_URL=https://wa-aios-api.onrender.com
TENANT_CONFIG_PATH=config/tenant.demo.json
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
RETELL_WEBHOOK_SECRET=generate-a-long-random-string

# --- Google Calendar (one shared calendar) ---
CALENDAR_PROVIDER=google
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxxxxx

# --- Customer messaging (Resend email) ---
MESSAGE_TRANSPORT_EMAIL=resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Atelier Nova <bookings@your-verified-domain.ch>
REPLY_TO_EMAIL=hello@your-verified-domain.ch
# MAIL_FROM is the legacy fallback for EMAIL_FROM.

# --- Conversational AI (inbound replies + reactivation copy) ---
# Optional: without it, inbound threads route to a human and reactivation uses templates.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
AIOS_AI_MODEL=claude-sonnet-5

# --- Dashboard ---
DASHBOARD_API_TOKEN=generate-a-long-random-string
NEXT_PUBLIC_DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111

# --- Instagram/WhatsApp DM follow-ups via ManyChat (optional) ---
MANYCHAT_API_KEY=
MESSAGE_TRANSPORT_INSTAGRAM=manychat
